/*
 * 画面左下、体力の欄とその上の能力の枠 (Hud.uss の .ability-slots、bottom 104px から上へ積む) のさらに上のテキストチャット。
 * Hud.uxml と ChatView が読み込み、行を古い順に上から積む。
 */
.chat {
    position: absolute;
    left: 32px;
    bottom: 230px;
    width: 560px;
    flex-direction: column;
    align-items: flex-start;
}

.chat__lines {
    flex-direction: column;
    align-items: flex-start;
}

.chat__row {
    margin: 2px 0 0 0;
    padding: 2px 10px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.45);
    font-size: 20px;
    color: rgb(255, 255, 255);
    white-space: normal;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.8s;
}

/* チームにだけ送った行。 */
.chat__row--team {
    color: rgb(120, 200, 255);
}

/* 届いてからしばらくたった行。入力中は ChatView が外して濃く戻す。 */
.chat__row--faded {
    opacity: 0.3;
}

.chat__input {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-top: 6px;
    padding: 4px 10px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.65);
}

.chat__prompt {
    margin: 0 8px 0 0;
    padding: 0;
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.chat__input--team .chat__prompt {
    color: rgb(120, 200, 255);
}

.chat__field {
    flex-grow: 1;
    margin: 0;
    font-size: 20px;
}
