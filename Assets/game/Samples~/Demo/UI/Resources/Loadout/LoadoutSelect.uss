/*
 * ロードアウトを選ぶ画面の中身。Shooter.Runtime.LoadoutSelectPanel が入れ物に読み込むので、HUD とメインメニューの両方で同じ見た目になる。
 * 入れ物の位置と幅は置く側 (Hud.uss の .hud__loadout、MainMenu.uss の .menu__loadout-slot) が決める。
 */

.loadout-select {
    padding: 20px 28px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.8);
}

.loadout-select__title {
    margin: 0 0 12px 0;
    padding: 0;
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.loadout-select__slot {
    margin: 0 0 12px 0;
    padding: 8px 12px;
    border-left-width: 6px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

/* ゲームパッド・キーボードで選んでいる行。 */
.loadout-select__slot--focused {
    border-color: rgb(255, 196, 64);
    background-color: rgba(255, 255, 255, 0.06);
}

.loadout-select__slot-title {
    margin: 0 0 6px 0;
    padding: 0;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.6);
}

.loadout-select__options {
    flex-direction: row;
    flex-wrap: wrap;
}

.loadout-select__option {
    min-width: 200px;
    margin: 0 12px 8px 0;
    padding: 8px 16px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    align-items: flex-start;
}

.loadout-select__option:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.loadout-select__option:focus {
    border-color: rgb(255, 255, 255);
}

/* そのスロットで選んでいる武器。 */
.loadout-select__option--selected {
    border-color: rgb(255, 196, 64);
    background-color: rgba(255, 196, 64, 0.25);
}

.loadout-select__option:disabled {
    opacity: 0.4;
}

.loadout-select__option-name {
    margin: 0;
    padding: 0;
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.loadout-select__option-category {
    margin: 2px 0 0 0;
    padding: 0;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.6);
}

/* レベルが足りず選べない武器。:disabled の 0.4 では鍵とレベルまで読みにくいので、薄さを抑えて背景を暗くする。 */
.loadout-select__option--locked {
    border-color: rgba(255, 255, 255, 0.3);
    background-color: rgba(0, 0, 0, 0.35);
}

.loadout-select__option--locked:disabled {
    opacity: 0.65;
}

.loadout-select__option-lock {
    flex-direction: row;
    align-items: center;
    margin: 6px 0 0 0;
}

/* 鍵の形。上の丸い掛け金と下の四角い胴を重ねる。 */
.loadout-select__lock-icon {
    width: 16px;
    height: 20px;
    margin: 0 8px 0 0;
    align-items: center;
}

.loadout-select__lock-shackle {
    width: 10px;
    height: 9px;
    border-width: 2px;
    border-bottom-width: 0;
    border-color: rgb(255, 196, 64);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

.loadout-select__lock-body {
    width: 16px;
    height: 11px;
    border-radius: 2px;
    background-color: rgb(255, 196, 64);
}

.loadout-select__lock-level {
    margin: 0;
    padding: 0;
    font-size: 18px;
    color: rgb(255, 196, 64);
    -unity-font-style: bold;
}

.loadout-select__no-option {
    margin: 0;
    padding: 0;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.5);
}

/* 能力の枠。武器の行と同じ枠線と強調を使い、中は前後のボタンで今の能力を挟む。 */
.loadout-select__ability-picker {
    flex-direction: row;
    align-items: center;
}

.loadout-select__ability-step {
    width: 48px;
    height: 48px;
    margin: 0;
    padding: 0;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.loadout-select__ability-step:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.loadout-select__ability-step:focus {
    border-color: rgb(255, 255, 255);
}

.loadout-select__ability-step:disabled {
    opacity: 0.4;
}

.loadout-select__ability-name {
    min-width: 240px;
    margin: 0 12px;
    padding: 0;
    font-size: 24px;
    color: rgb(255, 196, 64);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* 「なし」を選んでいる枠。能力を選んだ枠と見分けられるよう薄くする。 */
.loadout-select__ability-name--none {
    color: rgba(255, 255, 255, 0.5);
    -unity-font-style: normal;
}

/* プリセット (保存した組) の行。武器の行と同じ枠線と強調を使い、組の名前を前後のボタンで挟む。 */
.loadout-select__presets {
    margin: 0 0 12px 0;
    padding: 8px 12px;
    border-left-width: 6px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.loadout-select__presets--focused {
    border-color: rgb(255, 196, 64);
    background-color: rgba(255, 255, 255, 0.06);
}

.loadout-select__preset-title {
    margin: 0 0 6px 0;
    padding: 0;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.6);
}

.loadout-select__preset-picker {
    flex-direction: row;
    align-items: center;
}

.loadout-select__preset-step {
    width: 48px;
    height: 48px;
    margin: 0;
    padding: 0;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.loadout-select__preset-step:hover,
.loadout-select__preset-action:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.loadout-select__preset-step:focus,
.loadout-select__preset-action:focus {
    border-color: rgb(255, 255, 255);
}

.loadout-select__preset-step:disabled,
.loadout-select__preset-action:disabled {
    opacity: 0.4;
}

.loadout-select__preset-name {
    min-width: 240px;
    margin: 0 12px;
    padding: 0;
    font-size: 24px;
    color: rgb(255, 196, 64);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.loadout-select__preset-edit {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin: 8px 0 0 0;
}

.loadout-select__preset-name-field {
    min-width: 280px;
    margin: 0 12px 0 0;
    font-size: 20px;
    color: rgb(255, 255, 255);
}

.loadout-select__preset-action {
    height: 40px;
    margin: 0 12px 0 0;
    padding: 0 16px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(255, 255, 255);
    font-size: 20px;
}

.loadout-select__confirm {
    height: 56px;
    margin: 8px 0 0 0;
    border-width: 0;
    border-left-width: 6px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
}

.loadout-select__confirm--focused,
.loadout-select__confirm:focus {
    border-color: rgb(255, 196, 64);
    background-color: rgba(255, 196, 64, 0.2);
}

.loadout-select__confirm:disabled {
    opacity: 0.4;
}

.loadout-select__status {
    margin: 12px 0 0 0;
    padding: 0;
    font-size: 22px;
    color: rgb(160, 230, 160);
    white-space: normal;
}

.loadout-select__status--error {
    color: rgb(255, 120, 100);
}
