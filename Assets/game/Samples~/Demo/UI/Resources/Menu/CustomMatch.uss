/* カスタムマッチに入る画面の見た目。基準解像度は 1920x1080。差し込み口の位置は差し込む側 (メインメニューなど) が決める。 */

.custom-match {
    width: 640px;
    padding: 20px 28px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.8);
}

.custom-match__title {
    margin: 0 0 12px 0;
    padding: 0;
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.custom-match__description {
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.6);
    white-space: normal;
}

.custom-match__join-row {
    flex-direction: row;
    align-items: flex-end;
}

.custom-match__code-field {
    flex-grow: 1;
    height: 56px;
    margin: 8px 12px 0 0;
    font-size: 28px;
    -unity-font-style: bold;
}

.custom-match__code-field:disabled {
    opacity: 0.4;
}

.custom-match__button {
    height: 56px;
    margin: 8px 0 0 0;
    padding: 0 20px;
    border-width: 0;
    border-left-width: 6px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.custom-match__button:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.custom-match__button:focus {
    border-color: rgb(255, 196, 64);
    background-color: rgba(255, 196, 64, 0.2);
    color: rgb(255, 255, 255);
}

.custom-match__button:disabled {
    opacity: 0.4;
}

.custom-match__join {
    min-width: 160px;
}

.custom-match__back {
    margin-top: 20px;
}

.custom-match__notice {
    margin: 12px 0 0 0;
    padding: 0;
    font-size: 22px;
    color: rgb(255, 196, 64);
    white-space: normal;
}

.custom-match__notice--error {
    color: rgb(255, 120, 100);
}
