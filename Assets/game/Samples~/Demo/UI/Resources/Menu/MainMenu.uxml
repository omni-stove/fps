<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- メインメニュー。Shooter.Runtime.MainMenuScreen が UIDocument に読み込み、name でボタンを探して押したときの行き先をつなぐ。 -->
    <!-- text の "#キー" は文字列表 (Demo サンプルの Resources/Localization/ja/menu.json など) のキーで、MainMenuScreen が Shooter.Runtime.LocalizedTexts で今の言語の文字にする。 -->
    <Style src="MainMenu.uss" />
    <ui:VisualElement name="main-menu" class="menu">
        <ui:Label name="menu-title" text="#menu.title" class="menu__title" />
        <ui:VisualElement name="menu-buttons" class="menu__buttons">
            <!-- 並び順がゲームパッドで上下に動かすフォーカスの順番 (MainMenuScreen.ButtonNames と同じ)。 -->
            <ui:Button name="menu-campaign" text="#menu.campaign" class="menu__button" />
            <!-- -register-lobby で載った専用サーバーから、版が同じで満員でないものを選んでつなぐ (起動引数でサーバーを決めていればそこへ)。 -->
            <ui:Button name="menu-quick-match" text="#menu.quickMatch" class="menu__button" />
            <!-- パーティとコードで入るは、GameSignals.PartyControl / JoinByCode が出ているとき (EOS のあるビルド) だけ MainMenuScreen が出す。 -->
            <ui:Button name="menu-party" text="#menu.party" class="menu__button" style="display: none;" />
            <!-- 試合を立てた人から聞いた参加コードで、非公開の試合に入る。 -->
            <ui:Button name="menu-join-by-code" text="#menu.joinByCode" class="menu__button" style="display: none;" />
            <!-- -register-lobby で載った公開の専用サーバーを一覧にし、選んで入る。Shooter.Runtime.MainMenuPanels に画面が登録されているときだけ MainMenuScreen が出す。 -->
            <ui:Button name="menu-server-browser" text="#menu.serverBrowser" class="menu__button" style="display: none;" />
            <ui:Button name="menu-loadout" text="#menu.loadout" class="menu__button" />
            <!-- 成長の記録 (レベル・XP・戦績・次のアンロック) を出す。 -->
            <ui:Button name="menu-profile" text="#menu.profile" class="menu__button" />
            <!-- 統計・リーダーボード・リプレイ・見た目・持ち物庫・プレイリストは、Shooter.Runtime.MainMenuPanels に画面が登録されているときだけ MainMenuScreen が出す。 -->
            <ui:Button name="menu-stats" text="#menu.stats" class="menu__button" style="display: none;" />
            <ui:Button name="menu-leaderboard" text="#menu.leaderboard" class="menu__button" style="display: none;" />
            <ui:Button name="menu-replays" text="#menu.replays" class="menu__button" style="display: none;" />
            <ui:Button name="menu-cosmetics" text="#menu.cosmetics" class="menu__button" style="display: none;" />
            <ui:Button name="menu-stash" text="#menu.stash" class="menu__button" style="display: none;" />
            <!-- 決まった順でモードを回すプレイリスト (Resources/Tuning/playlists.json) を選んで始める。 -->
            <ui:Button name="menu-playlists" text="#menu.playlists" class="menu__button" style="display: none;" />
            <ui:Button name="menu-range" text="#menu.range" class="menu__button" />
            <!-- 射撃場を読み、終えたことがあってもチュートリアルを最初から出す。 -->
            <ui:Button name="menu-tutorial" text="#menu.tutorial" class="menu__button" />
            <ui:Button name="menu-settings" text="#menu.settings" class="menu__button" />
            <ui:Button name="menu-quit" text="#menu.quit" class="menu__button" />
        </ui:VisualElement>
        <!-- 案内 (切断の理由・シーンが無いなど)。空のときは MainMenuScreen が隠す。 -->
        <ui:Label name="menu-notice" text="" class="menu__notice" style="display: none;" />
        <!-- 設定画面の差し込み口。設定画面を作る側が MainMenuScreen.SettingsRequested で受け取って中身を入れる。 -->
        <ui:VisualElement name="menu-settings-slot" class="menu__settings-slot" style="display: none;" />
        <!-- オンラインで持っていく武器を選ぶ画面の差し込み口。MainMenuScreen が LoadoutSelectPanel で中身を作る。 -->
        <ui:VisualElement name="menu-loadout-slot" class="menu__loadout-slot" style="display: none;" />
        <!-- キャンペーンのミッションと難易度を選ぶ画面の差し込み口。MainMenuScreen が CampaignSelectPanel で中身を作る。 -->
        <ui:VisualElement name="menu-campaign-slot" class="menu__campaign-slot" style="display: none;" />
        <!-- プロフィールの差し込み口。MainMenuScreen が ProfilePanel で中身を作る。 -->
        <ui:VisualElement name="menu-profile-slot" class="menu__profile-slot" style="display: none;" />
        <!-- パーティの差し込み口。MainMenuScreen が PartyPanel で中身を作る (見た目は Party.uss)。 -->
        <ui:VisualElement name="menu-party-slot" class="menu__party-slot" style="display: none;" />
        <!-- 参加コードで入る画面の差し込み口。MainMenuScreen が CustomMatchPanel で中身を作る (見た目は CustomMatch.uss)。 -->
        <ui:VisualElement name="menu-custom-match-slot" class="menu__custom-match-slot" style="display: none;" />
        <!-- MainMenuPanels に登録された画面 (統計など) の差し込み口。どの画面もここを使い、中身は登録した側が作る。 -->
        <ui:VisualElement name="menu-panel-slot" class="menu__panel-slot" style="display: none;" />
    </ui:VisualElement>
</ui:UXML>
