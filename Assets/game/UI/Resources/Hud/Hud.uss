/* HUD の見た目。基準解像度は 1920x1080 (GameBootstrap の PanelSettings が画面サイズに合わせて拡縮する)。 */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud__panel {
    position: absolute;
    flex-direction: row;
    align-items: flex-end;
    padding: 6px 18px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.4);
}

.hud__panel--bottom-left {
    left: 32px;
    bottom: 32px;
}

.hud__panel--bottom-right {
    right: 32px;
    bottom: 32px;
}

.hud__panel--top-center {
    top: 24px;
    left: 50%;
    translate: -50% 0;
}

.hud__caption {
    margin: 0 10px 6px 0;
    padding: 0;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.7);
    -unity-font-style: bold;
}

.hud__value {
    margin: 0;
    padding: 0;
    font-size: 44px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: lower-left;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.hud__value--time {
    font-size: 36px;
    -unity-text-align: middle-center;
}

/* 残り時間の下に一時的に出す案内 (セーブした・再開まで N 秒)。 */
.hud__notice {
    position: absolute;
    top: 96px;
    left: 50%;
    translate: -50% 0;
    margin: 0;
    padding: 8px 20px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.5);
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.hud__panel--top-left {
    top: 24px;
    left: 32px;
    align-items: center;
}

/* チームの点数。文字の色は HudView がチームの色で塗る。 */
.hud__score {
    margin: 0;
    padding: 0;
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.hud__score--second {
    margin-left: 24px;
}

/* 画面右上のキルログ。行は古い順に上から並び、右端をそろえる。名前の色は KillFeedView がチームの色で塗る。 */
.kill-feed {
    position: absolute;
    top: 24px;
    right: 32px;
    flex-direction: column;
    align-items: flex-end;
}

.kill-feed__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding: 4px 12px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.45);
}

/* この画面のプレイヤーが倒したか倒された行。 */
.kill-feed__row--local {
    background-color: rgba(255, 255, 255, 0.22);
    border-width: 2px;
    border-color: rgb(255, 210, 80);
}

.kill-feed__name,
.kill-feed__weapon,
.kill-feed__friendly {
    margin: 0 4px;
    padding: 0;
    font-size: 22px;
    color: rgb(255, 255, 255);
    white-space: nowrap;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.kill-feed__name {
    -unity-font-style: bold;
}

.kill-feed__weapon {
    color: rgba(255, 255, 255, 0.8);
}

.kill-feed__weapon--headshot {
    color: rgb(255, 210, 80);
}

.kill-feed__friendly {
    color: rgb(255, 120, 60);
    -unity-font-style: bold;
}

/* 試合結果。画面中央の照準より上に大きく出す。 */
.hud__result {
    position: absolute;
    top: 30%;
    left: 50%;
    translate: -50% -50%;
    margin: 0;
    padding: 12px 32px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.55);
    font-size: 64px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.8);
}

/* 弾数の欄のすぐ上に右寄せで出す武器名。 */
.hud__weapon-name {
    position: absolute;
    right: 32px;
    bottom: 104px;
    margin: 0;
    padding: 4px 14px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.4);
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    white-space: nowrap;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* 弾数の欄のすぐ下に右寄せで出す、アクティブリロードの細いバー。塗りと幅の left / width は HudView が % で入れる。 */
.hud__reload-bar {
    position: absolute;
    right: 32px;
    bottom: 16px;
    width: 220px;
    height: 8px;
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0.5);
    overflow: hidden;
}

.hud__reload-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: rgb(255, 210, 80);
}

/* 塗りの後に置くので、塗りが重なっても幅が見える。 */
.hud__reload-window {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    background-color: rgba(90, 230, 120, 0.75);
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
}

/* リロード中の弾数。 */
.hud__value--reloading {
    color: rgb(255, 210, 80);
}

/* 体力が少ないとき。 */
.hud__value--low {
    color: rgb(255, 80, 70);
}

/*
 * 中央の照準。大きさ 0 の箱を画面の中央に置き、子をその点からの位置で並べる。
 * 線は中央に接する位置に置き、隙間は HudView が translate で足す。点と線は 1px の暗い縁で明るい背景でも見えるようにする
 * (width / height は縁を含むので、中の白は 2px)。
 */
.hud__crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    overflow: visible;
}

.hud__crosshair-dot,
.hud__crosshair-line {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.95);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.7);
}

.hud__crosshair-dot {
    left: -2px;
    top: -2px;
    width: 4px;
    height: 4px;
    border-radius: 1px;
}

.hud__crosshair-line--top,
.hud__crosshair-line--bottom {
    left: -2px;
    width: 4px;
    height: 12px;
}

.hud__crosshair-line--top {
    bottom: 0;
}

.hud__crosshair-line--bottom {
    top: 0;
}

.hud__crosshair-line--left,
.hud__crosshair-line--right {
    top: -2px;
    width: 12px;
    height: 4px;
}

.hud__crosshair-line--left {
    right: 0;
}

.hud__crosshair-line--right {
    left: 0;
}
