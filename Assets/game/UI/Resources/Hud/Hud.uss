/* HUD の見た目。基準解像度は 1920x1080 (GameBootstrap の PanelSettings が画面サイズに合わせて拡縮する)。 */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud__panel {
    position: absolute;
    flex-direction: row;
    align-items: flex-end;
    padding: 6px 18px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.4);
}

.hud__panel--bottom-left {
    left: 32px;
    bottom: 32px;
}

.hud__panel--bottom-right {
    right: 32px;
    bottom: 32px;
}

.hud__panel--top-center {
    top: 24px;
    left: 50%;
    translate: -50% 0;
}

.hud__caption {
    margin: 0 10px 6px 0;
    padding: 0;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.7);
    -unity-font-style: bold;
}

.hud__value {
    margin: 0;
    padding: 0;
    font-size: 44px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: lower-left;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.hud__value--time {
    font-size: 36px;
    -unity-text-align: middle-center;
}

/* 残り時間の下に一時的に出す案内 (セーブした・再開まで N 秒)。 */
.hud__notice {
    position: absolute;
    top: 96px;
    left: 50%;
    translate: -50% 0;
    margin: 0;
    padding: 8px 20px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.5);
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.hud__panel--top-left {
    top: 24px;
    left: 32px;
    align-items: center;
}

/* チームの点数。文字の色は HudView がチームの色で塗る。 */
.hud__score {
    margin: 0;
    padding: 0;
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.hud__score--second {
    margin-left: 24px;
}

/* 画面右上のキルログ。行は古い順に上から並び、右端をそろえる。名前の色は KillFeedView がチームの色で塗る。 */
.kill-feed {
    position: absolute;
    top: 24px;
    right: 32px;
    flex-direction: column;
    align-items: flex-end;
}

.kill-feed__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding: 4px 12px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.45);
}

/* この画面のプレイヤーが倒したか倒された行。 */
.kill-feed__row--local {
    background-color: rgba(255, 255, 255, 0.22);
    border-width: 2px;
    border-color: rgb(255, 210, 80);
}

.kill-feed__name,
.kill-feed__weapon,
.kill-feed__friendly {
    margin: 0 4px;
    padding: 0;
    font-size: 22px;
    color: rgb(255, 255, 255);
    white-space: nowrap;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.kill-feed__name {
    -unity-font-style: bold;
}

.kill-feed__weapon {
    color: rgba(255, 255, 255, 0.8);
}

.kill-feed__weapon--headshot {
    color: rgb(255, 210, 80);
}

.kill-feed__friendly {
    color: rgb(255, 120, 60);
    -unity-font-style: bold;
}

/* 試合結果。画面中央の照準より上に大きく出す。 */
.hud__result {
    position: absolute;
    top: 30%;
    left: 50%;
    translate: -50% -50%;
    margin: 0;
    padding: 12px 32px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.55);
    font-size: 64px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.8);
}

/* 弾数の欄のすぐ上に右寄せで出す武器名。 */
.hud__weapon-name {
    position: absolute;
    right: 32px;
    bottom: 104px;
    margin: 0;
    padding: 4px 14px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.4);
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    white-space: nowrap;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* 弾数の欄のすぐ下に右寄せで出す、アクティブリロードの細いバー。塗りと幅の left / width は HudView が % で入れる。 */
.hud__reload-bar {
    position: absolute;
    right: 32px;
    bottom: 16px;
    width: 220px;
    height: 8px;
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0.5);
    overflow: hidden;
}

.hud__reload-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: rgb(255, 210, 80);
}

/* 塗りの後に置くので、塗りが重なっても幅が見える。 */
.hud__reload-window {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    background-color: rgba(90, 230, 120, 0.75);
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
}

/* リロード中の弾数。 */
.hud__value--reloading {
    color: rgb(255, 210, 80);
}

/* 体力が少ないとき。 */
.hud__value--low {
    color: rgb(255, 80, 70);
}

/*
 * 中央の照準。大きさ 0 の箱を画面の中央に置き、子をその点からの位置で並べる。
 * 線は中央に接する位置に置き、隙間は HudView が translate で足す。点と線は 1px の暗い縁で明るい背景でも見えるようにする
 * (width / height は縁を含むので、中の白は 2px)。
 */
.hud__crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    overflow: visible;
}

.hud__crosshair-dot,
.hud__crosshair-line {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.95);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.7);
}

.hud__crosshair-dot {
    left: -2px;
    top: -2px;
    width: 4px;
    height: 4px;
    border-radius: 1px;
}

.hud__crosshair-line--top,
.hud__crosshair-line--bottom {
    left: -2px;
    width: 4px;
    height: 12px;
}

.hud__crosshair-line--top {
    bottom: 0;
}

.hud__crosshair-line--bottom {
    top: 0;
}

.hud__crosshair-line--left,
.hud__crosshair-line--right {
    top: -2px;
    width: 12px;
    height: 4px;
}

.hud__crosshair-line--left {
    right: 0;
}

.hud__crosshair-line--right {
    left: 0;
}

/* ロードアウトの選択。倒されている間に画面の中央に出す。中身の見た目は Resources/Loadout/LoadoutSelect.uss。 */
.hud__loadout {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 960px;
}

/* ポーズ画面。HUD の上に画面全体を暗く重ね、中央にボタンを縦に並べる。 */
.pause {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.pause__panel {
    min-width: 480px;
    padding: 32px 48px;
    border-radius: 10px;
    align-items: stretch;
    background-color: rgba(20, 20, 24, 0.9);
}

/* 設定画面の枠。中身 (SettingsView) は Menu/Settings.uss で塗り、ここでは大きさだけ決める。 */
.pause__settings {
    width: 1000px;
    height: 760px;
}

.pause__title {
    margin: 0 0 24px 0;
    font-size: 48px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pause__note {
    margin: 0 0 20px 0;
    font-size: 22px;
    color: rgb(255, 210, 120);
    -unity-text-align: middle-center;
    white-space: normal;
}

.pause__button {
    margin: 8px 0;
    padding: 12px 24px;
    font-size: 30px;
    border-width: 2px;
    border-radius: 6px;
    border-color: rgba(255, 255, 255, 0.25);
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(255, 255, 255);
}

.pause__button:hover,
.pause__button:focus {
    border-color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.2);
}

.pause__button:disabled {
    color: rgba(255, 255, 255, 0.35);
    border-color: rgba(255, 255, 255, 0.1);
}

/* スコアボード。Scoreboard を押している間だけ画面の中央に出す。行は ScoreboardView が作る。 */
.scoreboard {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 720px;
    padding: 16px 24px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.7);
}

.scoreboard__section {
    margin-top: 12px;
}

.scoreboard__caption,
.scoreboard__team,
.scoreboard__row {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
}

/* 文字の見た目はテーマの Label の既定より強くなるよう、行の子の Label に当てる。 */
.scoreboard__caption > .unity-label {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.6);
}

.scoreboard__team {
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.3);
}

/* チーム名の文字の色は ScoreboardView がチームの色で塗る。 */
.scoreboard__team > .unity-label {
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.scoreboard__row > .unity-label {
    font-size: 22px;
    color: rgb(255, 255, 255);
}

.scoreboard__row--local {
    background-color: rgba(255, 255, 255, 0.15);
}

.scoreboard__row--local > .unity-label {
    -unity-font-style: bold;
}

.scoreboard__row--disconnected > .unity-label {
    color: rgba(255, 255, 255, 0.4);
}

.scoreboard__name {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.scoreboard__count {
    width: 72px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-right;
}

.scoreboard__connection {
    width: 120px;
    margin: 0 0 0 24px;
    padding: 0;
    -unity-text-align: middle-right;
}

/*
 * ヒットマーカー。照準と同じく大きさ 0 の箱を画面の中央に置き、腕 (大きさ 0) を斜めに回して、その先に線を置く。
 * 拡大・回転の中心は大きさ 0 の箱の点 (= 画面の中央) になる。
 */
.hit-marker {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    overflow: visible;
}

.hit-marker__arm {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    overflow: visible;
}

.hit-marker__arm--top-right {
    rotate: -45deg;
}

.hit-marker__arm--bottom-right {
    rotate: 45deg;
}

.hit-marker__arm--bottom-left {
    rotate: 135deg;
}

.hit-marker__arm--top-left {
    rotate: -135deg;
}

.hit-marker__line {
    position: absolute;
    left: 10px;
    top: -2px;
    width: 14px;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.95);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.7);
}

/* 頭に当てたとき。 */
.hit-marker--head .hit-marker__line {
    background-color: rgb(255, 70, 60);
}

/* 倒したとき。 */
.hit-marker--kill {
    scale: 1.6 1.6;
}

/* 被弾方向。画面全体を覆い、弧の子要素 (大きさは親と同じ) を中央を軸に回す。弧の色は color で決める。 */
.damage-direction {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.damage-direction__arc {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgba(255, 60, 50, 0.85);
}

/* 拠点制圧。Hud の残り時間の欄と同じ上中央に、ポイントと残り時間の行・拠点の持ち主の行・結果を縦に並べる。色は DominationView がチームの色で塗る。 */
.domination {
    position: absolute;
    top: 24px;
    left: 50%;
    translate: -50% 0;
    flex-direction: column;
    align-items: center;
}

.domination__scores,
.domination__points {
    flex-direction: row;
    align-items: center;
    padding: 6px 18px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.4);
}

.domination__points {
    margin-top: 6px;
}

.domination__score,
.domination__time,
.domination__point {
    margin: 0 12px;
    padding: 0;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    white-space: nowrap;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.domination__score {
    font-size: 32px;
}

.domination__time {
    font-size: 36px;
}

.domination__point {
    font-size: 24px;
    padding: 2px 8px;
    border-radius: 4px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

/* 両チームがいて占領が止まっている拠点。 */
.domination__point--contested {
    border-color: rgb(255, 210, 80);
}

.domination__result {
    margin-top: 12px;
    padding: 12px 32px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.55);
    font-size: 64px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    white-space: nowrap;
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.8);
}

/* チュートリアルの今の手順。体力と弾数の欄の間 (画面下の中央) に出す。 */
.tutorial-prompt {
    position: absolute;
    bottom: 40px;
    left: 50%;
    translate: -50% 0;
    margin: 0;
    padding: 10px 28px;
    border-radius: 6px;
    border-bottom-width: 4px;
    border-color: rgb(255, 196, 64);
    background-color: rgba(0, 0, 0, 0.6);
    font-size: 30px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* すべて終えたとき。 */
.tutorial-prompt--completed {
    border-color: rgb(110, 220, 120);
    color: rgb(170, 255, 170);
}

/* オフラインのモードの左上の枠 (残り時間・陣営ごとの得点・モードが足す行・結果)。行は ModeHudView が足す。 */
.mode-hud {
    position: absolute;
    top: 24px;
    left: 32px;
    flex-direction: column;
    align-items: flex-start;
    padding: 8px 18px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.4);
}

.mode-hud__time {
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.mode-hud__scores,
.mode-hud__lines {
    flex-direction: column;
    align-items: flex-start;
}

.mode-hud__score {
    margin: 0;
    padding: 0;
    font-size: 28px;
    color: rgba(255, 255, 255, 0.8);
    -unity-font-style: bold;
    white-space: nowrap;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* 自分の陣営。 */
.mode-hud__score--own {
    color: rgb(120, 200, 255);
}

/* 単独で首位の陣営。 */
.mode-hud__score--leading {
    border-left-width: 4px;
    border-color: rgb(255, 196, 64);
    padding-left: 6px;
}

.mode-hud__line {
    margin: 4px 0 0 0;
    padding: 0;
    font-size: 24px;
    color: rgb(255, 255, 255);
    white-space: nowrap;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.mode-hud__result {
    margin: 8px 0 0 0;
    padding: 0;
    font-size: 32px;
    color: rgb(255, 196, 64);
    -unity-font-style: bold;
    white-space: nowrap;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}
