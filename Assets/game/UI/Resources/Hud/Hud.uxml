<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- HUD。GameBootstrap と NetHud が UIDocument に読み込み、Fps.Runtime.HudView が name で Label を探して文字列を入れる。 -->
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="hud-time-panel" class="hud__panel hud__panel--top-center" picking-mode="Ignore">
            <ui:Label name="hud-time" text="--:--" class="hud__value hud__value--time" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- チームの点数 (自分のチームが先)。チーム戦でなければ HudView が隠す。 -->
        <ui:VisualElement name="hud-score-panel" class="hud__panel hud__panel--top-left" picking-mode="Ignore" style="display: none;">
            <ui:Label name="hud-score-first" text="" class="hud__score" picking-mode="Ignore" />
            <ui:Label name="hud-score-second" text="" class="hud__score hud__score--second" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- 一時的な案内 (セーブした・再開まで N 秒)。HudView が空のときは隠す。 -->
        <ui:Label name="hud-notice" text="" class="hud__notice" picking-mode="Ignore" style="display: none;" />
        <!-- 試合結果 (勝ったチーム・引き分け)。試合が終わっている間だけ HudView が出す。 -->
        <ui:Label name="hud-result" text="" class="hud__result" picking-mode="Ignore" style="display: none;" />
        <ui:VisualElement name="hud-health-panel" class="hud__panel hud__panel--bottom-left" picking-mode="Ignore">
            <ui:Label text="HP" class="hud__caption" picking-mode="Ignore" />
            <ui:Label name="hud-health" text="--" class="hud__value" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- 持っている武器の名前。武器が無ければ HudView が隠す。 -->
        <ui:Label name="hud-weapon-name" text="" class="hud__weapon-name" picking-mode="Ignore" style="display: none;" />
        <ui:VisualElement name="hud-ammo-panel" class="hud__panel hud__panel--bottom-right" picking-mode="Ignore">
            <ui:Label text="AMMO" class="hud__caption" picking-mode="Ignore" />
            <ui:Label name="hud-ammo" text="-- / --" class="hud__value" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- アクティブリロードの進み (塗り) と成功になる幅。リロード中だけ HudView が出し、幅と塗りの長さを % で入れる。 -->
        <ui:VisualElement name="hud-reload-bar" class="hud__reload-bar" picking-mode="Ignore" style="display: none;">
            <ui:VisualElement name="hud-reload-fill" class="hud__reload-fill" picking-mode="Ignore" />
            <ui:VisualElement name="hud-reload-window" class="hud__reload-window" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- 照準 (中央の点と上下左右の線)。線と中央の隙間は HudView が広がりで translate し、ADS 中とダッシュ中は隠す。 -->
        <ui:VisualElement name="hud-crosshair" class="hud__crosshair" picking-mode="Ignore">
            <ui:VisualElement name="hud-crosshair-dot" class="hud__crosshair-dot" picking-mode="Ignore" />
            <ui:VisualElement name="hud-crosshair-top" class="hud__crosshair-line hud__crosshair-line--top" picking-mode="Ignore" />
            <ui:VisualElement name="hud-crosshair-bottom" class="hud__crosshair-line hud__crosshair-line--bottom" picking-mode="Ignore" />
            <ui:VisualElement name="hud-crosshair-left" class="hud__crosshair-line hud__crosshair-line--left" picking-mode="Ignore" />
            <ui:VisualElement name="hud-crosshair-right" class="hud__crosshair-line hud__crosshair-line--right" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- 以下は Hud と同じ GameObject のビュー (HudElementView) が name で受け取る枠。ビューが出すまで隠しておく。 -->
        <!-- ヒットマーカー (照準の周りの斜めの 4 本)。HitMarkerView が当てた直後だけ出し、頭・キルのクラスを付ける。 -->
        <ui:VisualElement name="hit-marker" class="hit-marker" picking-mode="Ignore" style="display: none;">
            <ui:VisualElement class="hit-marker__arm hit-marker__arm--top-right" picking-mode="Ignore">
                <ui:VisualElement class="hit-marker__line" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="hit-marker__arm hit-marker__arm--bottom-right" picking-mode="Ignore">
                <ui:VisualElement class="hit-marker__line" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="hit-marker__arm hit-marker__arm--bottom-left" picking-mode="Ignore">
                <ui:VisualElement class="hit-marker__line" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="hit-marker__arm hit-marker__arm--top-left" picking-mode="Ignore">
                <ui:VisualElement class="hit-marker__line" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 被弾方向。DamageDirectionView が撃たれた方向ごとに弧の子要素を足す。 -->
        <ui:VisualElement name="damage-direction" class="damage-direction" picking-mode="Ignore" style="display: none;" />
        <!-- 画面右上のキルログ。KillFeedView が行 (kill-feed__row) を入れ、行があるときだけ出す。 -->
        <ui:VisualElement name="kill-feed" class="kill-feed" picking-mode="Ignore" style="display: none;" />
        <!-- スコアボード。Scoreboard を押している間だけ ScoreboardView が行を作って出す。 -->
        <ui:VisualElement name="scoreboard" class="scoreboard" picking-mode="Ignore" style="display: none;" />
        <ui:VisualElement name="loadout-select" picking-mode="Ignore" style="display: none;" />
        <!-- ポーズ画面。開いている間だけ PauseMenu が出す。画面全体を覆い、後ろへのクリックを止める。 -->
        <ui:VisualElement name="pause-menu" class="pause" style="display: none;">
            <!-- ボタンの枠。設定画面を開いている間は PauseSettingsView が隠す。 -->
            <ui:VisualElement name="pause-panel" class="pause__panel">
                <ui:Label text="ポーズ" class="pause__title" />
                <!-- オンラインでは試合が止まらないことの案内。オフラインでは PauseMenu が隠す。 -->
                <ui:Label name="pause-note" text="" class="pause__note" style="display: none;" />
                <ui:Button name="pause-resume" text="再開" class="pause__button" />
                <ui:Button name="pause-settings" text="設定" class="pause__button" />
                <ui:Button name="pause-return-to-menu" text="メニューに戻る" class="pause__button" />
            </ui:VisualElement>
            <!-- 設定画面の枠。「設定」で PauseSettingsView が SettingsView の中身を入れて出す。 -->
            <ui:VisualElement name="pause-settings-slot" class="pause__settings" style="display: none;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
