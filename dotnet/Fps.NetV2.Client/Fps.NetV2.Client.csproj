<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity の Fps.NetV2.Client アセンブリ (Assets/game/Scripts/NetV2/Client) を Unity 抜きでビルドする。ソースは Assets 側が正 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Fps.Core/Fps.Core.csproj" />
    <ProjectReference Include="../Fps.Protocol/Fps.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Assets/game/Scripts/NetV2/Client/**/*.cs" />
  </ItemGroup>
</Project>
