<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity の Fps.Protocol アセンブリ (Assets/game/Scripts/Protocol) を Unity 抜きでビルドする。ソースは Assets 側が正 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Fps.Core/Fps.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Assets/game/Scripts/Protocol/**/*.cs" />
  </ItemGroup>
</Project>
