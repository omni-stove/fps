<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity 抜きで動く専用サーバー。試合のロジックは Fps.Core、通信の形は Fps.Protocol を Unity と共有する -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Fps.Server</RootNamespace>
    <AssemblyName>fps-server</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- InformationalVersion ではなく専用の鍵にするのは、SDK が既定の 1.0.0 や +<sha> を入れ、焼き込んでいないことと見分けられないため -->
  <ItemGroup Condition="'$(FpsBuildVersion)' != ''">
    <AssemblyMetadata Include="FpsBuildVersion" Value="$(FpsBuildVersion)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Fps.Server.Tests" />
    <InternalsVisibleTo Include="Fps.NetV2.Client.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Fps.Core/Fps.Core.csproj" />
    <ProjectReference Include="../Fps.Protocol/Fps.Protocol.csproj" />
    <ProjectReference Include="../Fps.EosSdk/Fps.EosSdk.csproj" />
    <ProjectReference Include="../Fps.Server.Eos/Fps.Server.Eos.csproj" />
  </ItemGroup>
</Project>
