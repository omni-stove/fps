<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity の Shooter.Aircraft.Core アセンブリ (Assets/game/Scripts/Aircraft/Core) を Unity 抜きでビルドする。ソースは Assets 側が正 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shooter.Core/Shooter.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Assets/game/Scripts/Aircraft/Core/**/*.cs" />
  </ItemGroup>
</Project>
