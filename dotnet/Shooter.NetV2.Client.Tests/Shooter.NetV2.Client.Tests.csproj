<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shooter.NetV2.Client/Shooter.NetV2.Client.csproj" />
    <!-- 本物の .NET のサーバーにつないで確かめる -->
    <ProjectReference Include="../Shooter.Server/Shooter.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- EOS の通信路で .NET のサーバーとつなぐのに、Shooter.Protocol.Tests の偽の EOS のネットワークを使う -->
    <Compile Include="../Shooter.Protocol.Tests/FakeEosNetwork.cs" Link="FakeEosNetwork.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
</Project>
