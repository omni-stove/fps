<Project Sdk="Microsoft.NET.Sdk">
  <!--
    .NET のサーバーが EOS の C# SDK を直接呼ぶ部分。SDK の型を使うファイルは #if EOS_SDK で囲み、SDK が無くてもビルドが通るようにする。
    Shooter.Server がこれを参照する (transport もここに置くので、逆向きにはしない)。
  -->
  <Import Project="../EosSdk.props" />
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Shooter.Server.Eos</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Shooter.EosSdk と同じく、参照元の -r の OS の SDK でコンパイルするため -->
    <IsRidAgnostic>false</IsRidAgnostic>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Shooter.Server" />
    <InternalsVisibleTo Include="shooter-server" />
    <InternalsVisibleTo Include="Shooter.Server.Eos.Tests" />
    <InternalsVisibleTo Include="Shooter.Server.Tests" />
    <InternalsVisibleTo Include="Shooter.NetV2.Client.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shooter.Core/Shooter.Core.csproj" />
    <ProjectReference Include="../Shooter.EosSdk/Shooter.EosSdk.csproj" />
    <ProjectReference Include="../Shooter.Protocol/Shooter.Protocol.csproj" />
  </ItemGroup>
</Project>
